# Lokale omgeving voor scripts/probe-models.mjs (npm run probe:ai).
# Kopieer naar .env en vul je sleutels in. .env is gitignored.

# Mistral (primair)
VIBE_CLI_KEY_BCG=
AI_MODEL=mistral-small-latest
AI_FALLBACK_MODEL=open-mistral-nemo

# Google Gemini (fallback, gratis tier)
GEMINI_API_KEY=
# Optioneel: overschrijf de modelketen (laat leeg voor de standaardreeks)
# GEMINI_MODEL_1=gemini-3.5-flash-lite
# GEMINI_MODEL_2=gemini-3.5-flash
# GEMINI_MODEL_3=gemini-3.6-flash
# Optioneel: Api-Revision header van de Interactions API (leeg = geen header)
# GEMINI_API_REVISION=2026-05-20

# OpenRouter (derde, gratis fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
